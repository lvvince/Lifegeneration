# ---------- Environment files ----------
.env
.env.*
!.env.example
# Uncomment ONLY if frontend/.env.production holds non-secret values (e.g. the API URL)
# !frontend/.env.production

# ---------- OS generated files ----------
.DS_Store
Thumbs.db
ehthumbs.db

# ---------- Editor directories ----------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ---------- Dependencies and build output (anchored to real locations) ----------
/node_modules/
/frontend/node_modules/
/frontend/dist/
/backend/vendor/
/backend/app/vendor/

# ---------- Database dumps ----------
*.sql
*.sqlite
# Allow official schema dump
!database.sql
!**/database.sql

# ---------- User uploads (receipts remain private) ----------
/backend/public/uploads/receipts/*
!/backend/public/uploads/receipts/.gitkeep

# ---------- Runtime ----------
/backend/runtime/*
!/backend/runtime/.gitkeep