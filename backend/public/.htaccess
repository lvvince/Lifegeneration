<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect trailing slashes (GET/HEAD only, so API POST/OPTIONS requests aren't redirected)
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # API requests go through LavaLust (index.php)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(api(/.*)?)$ index.php/$1 [L,QSA]

    # Missing uploads return 404 directly instead of falling back to index.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^uploads/ - [R=404,L]

    # Everything else that isn't a real file goes to the React app
    # (fixes refresh on /events, /login, etc.)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.html [L]
</IfModule>

<FilesMatch "^(\.env|composer\.(json|lock)|package\.json|package-lock\.json|\.git)">
    Require all denied
</FilesMatch>

AddDefaultCharset UTF-8