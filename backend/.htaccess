AddDefaultCharset UTF-8
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass the Authorization header (Bearer token) through to PHP
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Serve real files and folders directly (uploads, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes to LavaLust
    RewriteRule ^(.*)$ index.php/$1 [L,QSA]
</IfModule>

# Block sensitive file types
<FilesMatch "\.(env|log|md|lock|ini|bak|sql)$">
    Require all denied
</FilesMatch>