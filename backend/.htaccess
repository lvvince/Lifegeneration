AddDefaultCharset UTF-8
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass the Authorization header (Bearer token) through to PHP
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Serve real files and folders directly (React assets, uploads, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # /api/... goes to LavaLust
    RewriteRule ^api(/.*)?$ index.php/$0 [L,QSA]

    # Everything else falls back to the React app (fixes refresh on /events, /login, etc.)
    RewriteRule ^ index.html [L]
</IfModule>

# Block sensitive file types
<FilesMatch "\.(env|log|md|lock|ini|bak|sql)$">
    Require all denied
</FilesMatch>